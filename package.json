{
  "name": "graphly",
  "version": "0.1.0",
  "description": "A treemap page-index component and Taggly-backed document graph generator",
  "type": "module",
  "bin": {
    "graphly": "dist/main.js"
  },
  "files": [
    "dist",
    "viewer",
    "component"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild component/entry.js --bundle --format=esm --outfile=component/d3_hierarchy.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "graphly": "tsx src/main.ts"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "d3-hierarchy": "^3.1.2",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
