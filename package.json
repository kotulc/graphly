{
  "name": "graphly",
  "version": "0.1.0",
  "description": "A document knowledge graph generator built with Graphology and Sigma.js",
  "type": "module",
  "bin": {
    "graphly": "dist/main.js"
  },
  "files": [
    "dist",
    "viewer"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "graphly": "tsx src/main.ts",
    "postinstall": "node scripts/setup-taggly.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "graphology": "^0.26.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "graphology-types": "^0.24.8",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
